generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id                 String   @id @default(uuid())
  name               String
  projectType        String
  state              String
  district            String
  landArea            Float
  affectedFamilies   Int

  compensationStatus   String   @default("PENDING")
  approvalStatus       String   @default("PENDING")
  legalDispute        Boolean   @default(false)
  possessionStatus     String   @default("PENDING")
  rehabilitationStatus String   @default("PENDING")
  
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}